# ============================================================
#  qa-track node-agent — variáveis de ambiente
# ============================================================
#  Copie para `.env` e ajuste para sua máquina.
# ============================================================

# URL pública do QA Track dashboard (onde o agent se anuncia)
DASHBOARD_URL=http://localhost:3000

# Identificação deste node no dashboard (único)
AGENT_NAME=meu-pc

# URL pública DESTE node, como o dashboard vai alcançá-lo.
# Rodando no host Windows/Mac com dashboard em Docker:
#   AGENT_PUBLIC_URL=http://host.docker.internal:4724
AGENT_PUBLIC_URL=http://localhost:4724

# Porta local do agent
AGENT_PORT=4724

# Caminho do binário adb (deixe em branco se já está no PATH).
ADB_PATH=
